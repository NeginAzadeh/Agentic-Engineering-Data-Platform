# Allow only the runtime's source/configuration files into the build context.
**
!Dockerfile
!requirements-dbt.txt
!orchestration/
!orchestration/requirements-pipeline.txt
!orchestration/pipeline_runtime.py
!src/
!src/engineering_intelligence/
!src/engineering_intelligence/ingest_github.py
!src/engineering_intelligence/load_github.py
!src/engineering_intelligence/verify_dbt_kpis.py
!sql/
!sql/analytics/
!sql/analytics/*.sql
!dbt/
!dbt/dbt_project.yml
!dbt/profiles.yml
!dbt/models/
!dbt/models/**/
!dbt/models/**/*.sql
!dbt/models/**/*.yml
!dbt/tests/
!dbt/tests/*.sql
!containerization/
!containerization/run_pipeline.py

# Defense in depth if new allow rules are added later.
**/.git
**/.venv
**/.aws
**/.airflow
**/data
**/logs
dbt/target
dbt/dbt_packages
dbt/.user.yml
dbt/profiles.local.yml
**/airflow.cfg
**/simple_auth_manager_passwords*
**/standalone_admin_password.txt
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/*credentials*
**/*.pem
**/*.key
**/*.duckdb*
**/*.log
