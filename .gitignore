# Python bytecode and caches
__pycache__/
*.py[cod]

# Local virtual environments
.venv/
venv/
env/

# Local environment variables and credentials
.env
.env.*
!.env.example
.aws/

# Test, coverage, and code-checking output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python build output
build/
dist/
*.egg-info/

# Notebook checkpoints (not the notebooks themselves)
.ipynb_checkpoints/

# Local datasets and generated pipeline output
# Small, non-sensitive sample data can later live in data/samples/.
data/raw/
data/interim/
data/processed/
data/reports/
logs/
*.log

# Personal editor settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# dbt generated artifacts (keep profiles.yml and model SQL version-controlled)
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
dbt/profiles.local.yml
